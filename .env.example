# Local Supabase. Copy to .env.local after `pnpm db:start`.
# Never put live keys, service role, or OAuth secrets in the repository.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enables password login, local signup and visible fixture credentials only
# when NEXT_PUBLIC_SUPABASE_URL also points to loopback. Never enable remotely.
PULPERIA_LOCAL_TEST_AUTH=true

# Public origin used by canonical URLs, Open Graph and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Keeps a public testing deployment out of search indexes until owner launch.
PULPERIA_PRELAUNCH=true

# PMTiles archive served with HTTP range requests. The local refresh script
# refreshes the versioned regional runtime artifact at this path.
NEXT_PUBLIC_PMTILES_URL=/maps/siguatepeque.pmtiles
PULPERIA_PMTILES_SOURCE_URL=https://data.source.coop/protomaps/openstreetmap/v4.pmtiles

# Server-only. Local demo values from `supabase start`. Not for the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth stays empty until Ale authorizes a real client.
GOOGLE_OAUTH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
